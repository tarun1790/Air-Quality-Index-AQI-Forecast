[Unit]
Description=Purple AQI Forecast FastAPI Backend
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/purple-aqi/backend
EnvironmentFile=/var/www/purple-aqi/backend/.env
ExecStart=/var/www/purple-aqi/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
